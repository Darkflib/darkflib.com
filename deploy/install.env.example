# Host policy for darkflib.com, read (never sourced, never written) by deploy/install.sh.
#
#     sudo install -m 0600 /etc/darkflib/install.env.example /etc/darkflib/install.env
#     sudo "$EDITOR" /etc/darkflib/install.env
#     sudo deploy/install.sh --start
#
# The file's absence is the default. SRETAB_PAT below is a credential, so the installer refuses a file that holds one
# unless it is root's and no one else can read or write it (mode 0600 or 0400).

# Host port on 127.0.0.1 that darkflib-web publishes, and that host nginx proxies to. Default 8080, which orbit-data
# already uses on ny03; ny03 uses 8082. Only the host side moves: the container still listens on 8080.
#
# Check it is free first:  ss -lntp | grep ':8082 '
#
# The installer stages the change; a restart adopts it (--start does both). Keep deploy/nginx/darkflib.conf's
# upstream in step.
#DARKFLIB_WEB_PORT=8082

# A personal access token for https://sretab.mikepreston.org, whose account is on sre-tab's allow-list. A read-only
# token is enough: darkflib-kev.service only reads /api/v1/feed?sources=cisa-kev.
#
# Every installer run copies it into the podman secret darkflib-sretab-pat, which only darkflib-kev.service receives,
# so a rotated token is used from the next hourly refresh. --start enables that timer and refreshes once. Unset or
# empty means no KEV panel: the installer removes the secret and disables the timer, and the page hides the panel once
# the last snapshot is a week old.
#SRETAB_PAT=
