# darkflib.com inner web server. Baked into the image by the Containerfile, so this policy ships with the code it
# describes.
#
# Listens on :8080 inside the container, published to 127.0.0.1 only. Host nginx terminates TLS for darkflib.com,
# darkflib.dev, and both wildcards, and forwards everything here with the Host header intact; routing by name happens
# below, where CI can test it (deploy/scripts/smoke.sh).
{
	admin off
	auto_https off

	servers {
		# 10.89.62.1 is darkflib.network's gateway: the source address of anything reaching the published loopback
		# port. Trusting it makes the access log record nginx's X-Forwarded-For (the real client) rather than the
		# gateway. Nothing here makes a security decision on the client address.
		trusted_proxies static 10.89.62.1/32
		client_ip_headers X-Forwarded-For
	}
}

# Fault Lab origins: static JSON the site's status client polls. Healthy by design; failures are injected in the
# visitor's own browser by the service worker. CORS for the site only, Timing-Allow-Origin so Resource Timing reports
# full detail, cross-origin CORP so the documents are usable cross-site, and no-store so every poll reaches the network.
(lab_origin) {
	root * /srv/lab/{args[0]}
	header {
		Access-Control-Allow-Origin "https://darkflib.com"
		Vary "Origin"
		Timing-Allow-Origin "https://darkflib.com"
		Cross-Origin-Resource-Policy "cross-origin"
		Cache-Control "no-store"
		# Machine-readable status documents, not pages: keep them out of search results.
		X-Robots-Tag "noindex"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
	file_server
}

(security_headers) {
	header {
		# Same-origin except connect-src, which admits the three Fault Lab origins (public/lab/config.json lists the
		# same three) and mikepreston.org, whose API takes the contact form; deploy/scripts/smoke.sh checks the set
		# agrees. Verified with no violations in Chromium, Firefox, and WebKit (tests/deploy). React sets inline styles
		# through the CSSOM, which style-src does not govern.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self' https://api.darkflib.com https://api.darkflib.dev https://media.darkflib.com https://mikepreston.org; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		# No includeSubDomains and no preload: both are hard to walk back.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
		-Server
	}
}

:8080 {
	encode zstd gzip

	# Container healthcheck, answered for any Host.
	handle /healthz {
		respond "ok" 200
	}

	@www host www.darkflib.com
	handle @www {
		redir https://darkflib.com{uri} permanent
	}

	@lab_api_primary host api.darkflib.com
	handle @lab_api_primary {
		import lab_origin api-primary
	}

	# Cross-site on purpose: a different registrable domain from the site.
	@lab_api_secondary host api.darkflib.dev
	handle @lab_api_secondary {
		import lab_origin api-secondary
	}

	@lab_media host media.darkflib.com
	handle @lab_media {
		import lab_origin media
	}

	# The .dev apex is not a lab origin; send visitors to the site, temporarily so nothing caches the answer.
	@dev host darkflib.dev www.darkflib.dev
	handle @dev {
		redir https://darkflib.com{uri} 302
	}

	@site host darkflib.com
	handle @site {
		root * /srv/www
		import security_headers

		# Content-hashed by Vite: cache forever. Only on files that exist, so a missing bundle is a 404 nobody caches.
		handle /assets/* {
			@hashed file
			header @hashed Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		# wwff-auth (Darkflib/wwff-auth): sign-in, sessions, and passkeys under /auth/*, from its own container on
		# darkflib.network (gitops quadlet/apps/wwff-auth/). WWFF_AUTH_UPSTREAM exists for the smoke test's stand-in.
		# /auth/verify answers forward_auth below and nothing else: from outside it is a 404.
		handle /auth/verify {
			respond 404
		}

		handle /auth/* {
			# Sessions and ceremonies are never stored, by nginx or the browser, whatever the service sends. Deferred,
			# so it replaces the upstream's header rather than being replaced by it.
			header >Cache-Control "no-store"
			reverse_proxy {$WWFF_AUTH_UPSTREAM:wwff-auth:8000}
		}

		# The private tools. Every request asks wwff-auth first and carries its answer as X-Auth-* headers. Without a
		# session, a page load goes to /login/ and anything else gets the service's 401 as it is.
		handle /tools/* {
			# route keeps this order. Caddy's default order runs forward_auth before request_header, which would strip
			# the headers forward_auth just set, or else let a client's own X-Auth-* through wherever /auth/verify
			# leaves one out.
			route {
				request_header -X-Auth-*
				# Only for whoever asked: nginx must never hand a stored copy to the next visitor. Deferred and ahead of
				# forward_auth, so the redirect and the 401 carry it as well as the page.
				header >Cache-Control "private, no-store"
				forward_auth {$WWFF_AUTH_UPSTREAM:wwff-auth:8000} {
					uri /auth/verify
					copy_headers X-Auth-User X-Auth-Level X-Auth-Federated-At X-Auth-Standard-At X-Auth-High-At

					@denied status 401
					handle_response @denied {
						# A request matcher: handle_response's own matchers only see the service's response.
						@navigate header Sec-Fetch-Mode navigate
						# The path alone: Caddy has no query-escaping placeholder, and the login page resolves next as a
						# same-origin URL either way.
						redir @navigate /login/?next={http.request.uri.path} 303
						copy_response
					}
				}
				# The session debugger's view of what a tool receives: the X-Auth-* headers exactly as forward_auth left
				# them (empty where /auth/verify sent none). Only wwff-auth can have set them, since client copies are
				# stripped above, and its values are ids, level names, and Unix seconds.
				@auth_headers path /tools/debug/headers.json
				header @auth_headers Content-Type application/json
				respond @auth_headers `{"X-Auth-User": "{http.request.header.X-Auth-User}", "X-Auth-Level": "{http.request.header.X-Auth-Level}", "X-Auth-Federated-At": "{http.request.header.X-Auth-Federated-At}", "X-Auth-Standard-At": "{http.request.header.X-Auth-Standard-At}", "X-Auth-High-At": "{http.request.header.X-Auth-High-At}"}` 200
				file_server
			}
		}

		# The KEV snapshot, written hourly by darkflib-kev.service into the darkflib-feeds volume, mounted read-only
		# here. Five minutes of freshness lets nginx absorb visitors for a file that changes at most hourly. Only
		# kev.json is served, never the fetcher's dotfile temporaries. Before the first fetch (or with no PAT
		# configured, or no volume at all under a plain `podman run`) the answer is 204: the page hides the panel, and
		# unlike a 404 it leaves the console clean.
		handle_path /feeds/* {
			root * /srv/feeds

			@snapshot {
				path /kev.json
				file
			}
			handle @snapshot {
				header Cache-Control "public, max-age=300"
				file_server
			}

			@no_snapshot path /kev.json
			handle @no_snapshot {
				header Cache-Control "no-cache"
				respond 204
			}

			handle {
				respond 404
			}
		}

		# Generated imagery keeps stable names, so a day rather than forever.
		handle /images/* {
			@present file
			header @present Cache-Control "public, max-age=86400"
			file_server
		}

		# index.html and /service-worker.js. Revalidate every time: a stale copy of either is how a deploy goes
		# unseen, and a cached worker script can pin visitors to an old site. nginx will not cache these.
		handle {
			header Cache-Control "no-cache"
			file_server
		}
	}

	# Every other name the wildcards deliver (unused *.darkflib.com and *.darkflib.dev) and direct IP access.
	handle {
		respond 404
	}

	log
}
