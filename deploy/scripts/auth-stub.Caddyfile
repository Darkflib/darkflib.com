# A stand-in for wwff-auth (and for wwff-recon's /tools/domain/api/* and wwff-pagerecon's /tools/page/api/*), run by smoke.sh from the site's own image: just enough of /auth/verify and /auth/session
# to exercise deploy/Caddyfile's routing. A request carrying the cookie smoke=1 is signed in.
{
	admin off
	auto_https off
}

:8000 {
	# deploy/Caddyfile strips client X-Auth-* headers before asking; one arriving here means it did not.
	@forged header X-Auth-High-At *
	handle @forged {
		respond "forged X-Auth-* header reached the auth service" 400
	}

	@signed_in header Cookie *smoke=1*
	# Per-tool answers, keyed on the path Caddy's forward_auth passes as X-Forwarded-Uri (wwff-auth docs/contract.md):
	# /tools/locked/ is a tool the stand-in user holds no role for, /tools/stepup/ one whose role needs a passkey,
	# /tools/reauth/ one whose role needs a fresh GitHub/Google sign-in, and everything else is allowed with the role
	# "user".
	@tool_forbidden header X-Forwarded-Uri /tools/locked/*
	@tool_step_up header X-Forwarded-Uri /tools/stepup/*
	@tool_reauth header X-Forwarded-Uri /tools/reauth/*
	handle /auth/verify {
		handle @signed_in {
			handle @tool_forbidden {
				header Content-Type application/problem+json
				respond `{"reason": "tool_forbidden", "tool": "locked"}` 403
			}
			handle @tool_step_up {
				header Content-Type application/problem+json
				header WWW-Authenticate `Passkey error="insufficient_user_authentication", tier="STANDARD", max_age=900`
				respond `{"step_up": {"tier": "STANDARD", "max_age": 900, "action": "tool:stepup", "bound": false, "reason": "missing"}}` 401
			}
			handle @tool_reauth {
				header Content-Type application/problem+json
				header WWW-Authenticate `Passkey error="insufficient_user_authentication", tier="FEDERATED", max_age=43200`
				respond `{"step_up": {"tier": "FEDERATED", "max_age": 43200, "action": "tool:reauth", "bound": false, "reason": "stale"}}` 401
			}
			header X-Auth-User smoke-user
			header X-Auth-Level FEDERATED
			header X-Auth-Federated-At {time.now.unix}
			header X-Auth-Roles user
			respond 204
		}
		respond `{"reason": "no_session"}` 401
	}

	handle /auth/tools {
		handle @signed_in {
			header Content-Type application/json
			respond `{"roles": {"held": ["user", "admin"], "active": ["user"]}, "tools": [{"slug": "debug", "active": true, "step_up": null}, {"slug": "stepup", "active": false, "step_up": {"tier": "STANDARD", "max_age": 900}}, {"slug": "reauth", "active": false, "step_up": {"tier": "FEDERATED", "max_age": 43200}}]}` 200
		}
		respond `{"reason": "no_session"}` 401
	}

	# Shaped as the contract's session, so the pages render it. Cacheable, so the smoke test can see the site's
	# Caddyfile override that.
	handle /auth/session {
		header Cache-Control "public, max-age=600"
		handle @signed_in {
			header Content-Type application/json
			respond `{"user": {"id": "smoke-user", "display_name": "Smoke", "email": null}, "expires_at": "2099-01-01T00:00:00Z", "login_method": "github", "has_passkey": false, "identities": [{"id": "i1", "provider": "github", "label": "smoke"}], "assurance": {"FEDERATED": {"auth_at": "2026-01-01T00:00:00Z", "age": 1}, "STANDARD": null, "HIGH": null}, "roles": {"held": ["user", "admin"], "active": ["user"]}, "credits": {"balances": {"domain": 3, "page": 3}}}` 200
		}
		respond 204
	}

	handle /auth/credentials {
		handle @signed_in {
			header Content-Type application/json
			respond `[{"id": "c1", "nickname": "Smoke key", "tier": "STANDARD", "tier_reason": "not_requested", "created_at": "2026-01-01T00:00:00Z", "last_used_at": null, "synced": true, "in_cooldown": false, "cooldown_until": null, "flagged": false}]` 200
		}
		respond `{"reason": "no_session"}` 401
	}

	# The admin API (wwff-auth docs/contract.md, Administration), stateless: one user, u2, whose details never change.
	handle /auth/admin/users {
		handle @signed_in {
			header Content-Type application/json
			respond `{"users": [{"id": "u2", "display_name": "Alice Example", "email": "alice@example.com", "identities": [{"provider": "github", "label": "alice"}], "roles": ["user"], "created_at": "2026-01-01T00:00:00Z", "last_seen_at": null}], "next": null}` 200
		}
		respond `{"reason": "no_session"}` 401
	}
	@admin_role_admin path /auth/admin/users/u2/roles/admin
	handle @admin_role_admin {
		header Content-Type application/problem+json
		respond `{"reason": "role_not_web_grantable"}` 403
	}
	@admin_role {
		path /auth/admin/users/u2/roles/*
		method PUT DELETE
	}
	handle @admin_role {
		respond 204
	}
	@admin_credits {
		path /auth/admin/users/u2/credits
		method POST
	}
	handle @admin_credits {
		header Content-Type application/json
		respond `{"type": "domain", "balance": 8, "entry": {"id": "l2", "type": "domain", "delta": 5, "balance_after": 8, "kind": "grant", "note": "smoke", "actor": "admin:smoke-user", "ref": null, "created_at": "2026-01-02T00:00:00Z"}}` 200
	}
	handle /auth/admin/users/u2 {
		header Content-Type application/json
		respond `{"id": "u2", "display_name": "Alice Example", "email": "alice@example.com", "created_at": "2026-01-01T00:00:00Z", "last_seen_at": null, "identities": [{"provider": "github", "label": "alice", "linked_at": "2026-01-01T00:00:00Z"}], "roles": {"held": ["admin", "user"], "web_grantable": ["user"]}, "passkeys": [], "credits": {"balances": {"domain": 3}, "recent": [{"id": "l1", "type": "domain", "delta": 3, "balance_after": 3, "kind": "grant", "note": "welcome", "actor": "admin:smoke-user", "ref": null, "created_at": "2026-01-01T00:00:00Z"}]}}` 200
	}

	# wwff-recon (Darkflib/wwff-recon docs/contract.md), stateless: every new run is the same finished run (r1), one
	# check succeeding and one failing, so the page renders both; the list (whatever its query) has r2 and r1.
	@recon_start {
		path /tools/domain/api/runs
		method POST
	}
	handle @recon_start {
		header Content-Type application/json
		respond `{"id": "r1", "domain": "example.com", "domain_unicode": "example.com", "domain_a_label": "example.com", "checks": ["rdap", "tls"], "status": "complete", "created_at": "2026-01-01T00:00:00Z", "completed_at": "2026-01-01T00:00:02Z", "cost": 1, "refunded": false, "balance_after": 2, "results": {"rdap": {"collector": "rdap", "ok": true, "duration_ms": 412.5, "data": {"data_source": "rdap", "registered_at": "1995-08-14T04:00:00Z", "expires_at": "2027-08-13T04:00:00Z", "age_days": 11386, "status": ["client delete prohibited"], "nameservers": [{"ldh_name": "a.iana-servers.net"}], "entities": [{"roles": ["registrar"], "vcard": {"fn": "RESERVED-Internet Assigned Numbers Authority"}}]}, "error": null}, "tls": {"collector": "tls", "ok": false, "duration_ms": 10000, "data": null, "error": {"kind": "timeout", "retryable": true, "upstream": "example.com:443", "message": "TLS handshake timed out"}}}}` 200
	}
	handle /tools/domain/api/runs/r1 {
		header Content-Type application/json
		respond `{"id": "r1", "domain": "example.com", "domain_unicode": "example.com", "domain_a_label": "example.com", "checks": ["rdap", "tls"], "status": "complete", "created_at": "2026-01-01T00:00:00Z", "completed_at": "2026-01-01T00:00:02Z", "cost": 1, "refunded": false, "balance_after": 2, "results": {"rdap": {"collector": "rdap", "ok": true, "duration_ms": 412.5, "data": {"data_source": "rdap", "registered_at": "1995-08-14T04:00:00Z", "expires_at": "2027-08-13T04:00:00Z", "age_days": 11386, "status": ["client delete prohibited"], "nameservers": [{"ldh_name": "a.iana-servers.net"}], "entities": [{"roles": ["registrar"], "vcard": {"fn": "RESERVED-Internet Assigned Numbers Authority"}}]}, "error": null}, "tls": {"collector": "tls", "ok": false, "duration_ms": 10000, "data": null, "error": {"kind": "timeout", "retryable": true, "upstream": "example.com:443", "message": "TLS handshake timed out"}}}}` 200
	}
	# A later run of the same domain, for comparing: a changed status, TLS that now answers (with a chain to draw),
	# HTTP with a redirect, and what the CT logs hold (two issuers, a wildcard, an expired name).
	handle /tools/domain/api/runs/r2 {
		header Content-Type application/json
		respond `{"id": "r2", "domain": "example.com", "domain_unicode": "example.com", "domain_a_label": "example.com", "checks": ["rdap", "tls", "headers", "ct"], "status": "complete", "created_at": "2026-01-08T00:00:00Z", "completed_at": "2026-01-08T00:00:03Z", "cost": 1, "refunded": false, "balance_after": 1, "results": {"rdap": {"collector": "rdap", "ok": true, "duration_ms": 398.0, "data": {"data_source": "rdap", "age_days": 11393, "status": ["client delete prohibited", "client transfer prohibited"], "nameservers": [{"ldh_name": "a.iana-servers.net"}], "entities": [{"roles": ["registrar"], "vcard": {"fn": "RESERVED-Internet Assigned Numbers Authority"}}]}, "error": null}, "tls": {"collector": "tls", "ok": true, "duration_ms": 220.0, "data": {"connection": {"protocol": "TLSv1.3", "cipher_name": "TLS_AES_256_GCM_SHA384"}, "leaf_certificate": {"subject": {"common_name": "example.com"}, "issuer": {"common_name": "R11"}, "serial_number": "01", "not_after": "2099-01-01T00:00:00Z", "san_dns": ["example.com"], "is_ca": false, "is_self_signed": false}, "chain": [{"subject": {"common_name": "example.com"}, "issuer": {"common_name": "R11"}, "serial_number": "01", "not_after": "2099-01-01T00:00:00Z", "is_ca": false, "is_self_signed": false}, {"subject": {"common_name": "R11"}, "issuer": {"common_name": "ISRG Root X1"}, "serial_number": "02", "not_after": "2099-01-01T00:00:00Z", "is_ca": true, "is_self_signed": false}], "accepted_versions": ["TLSv1.2", "TLSv1.3"], "ocsp_stapled": false}, "error": null}, "headers": {"collector": "headers", "ok": true, "duration_ms": 150.0, "data": {"url": "http://example.com/", "final_url": "https://www.example.com/", "status_code": 200, "http_version": "HTTP/2", "server": "ECS", "redirect_chain": [{"url": "http://example.com/", "status_code": 301, "location": "https://www.example.com/"}], "security": {"hsts": null, "csp": null}, "cookies": [], "http_upgrade": {"redirects_to_https": true}}, "error": null}, "ct": {"collector": "ct", "ok": true, "duration_ms": 1300.0, "data": {"source": "crt.sh", "history": true, "fallback_reason": null, "total": 3, "current": 2, "expired": 1, "first_issued": "2019-03-01T00:00:00Z", "last_issued": "2026-01-01T00:00:00Z", "certificates": [{"id": "101", "serial": "aa", "issuer": "C=US, O=Let's Encrypt, CN=R11", "issuer_name": "Let's Encrypt", "common_name": "example.com", "names": ["example.com", "www.example.com"], "not_before": "2026-01-01T00:00:00Z", "not_after": "2099-01-01T00:00:00Z", "current": true, "wildcard": false, "url": "https://crt.sh/?id=101"}, {"id": "102", "serial": "bb", "issuer": "C=US, O=DigiCert Inc, CN=DigiCert Global G2 TLS RSA SHA256 2020 CA1", "issuer_name": "DigiCert Inc", "common_name": "*.example.com", "names": ["*.example.com", "example.com"], "not_before": "2025-06-01T00:00:00Z", "not_after": "2099-06-01T00:00:00Z", "current": true, "wildcard": true, "url": "https://crt.sh/?id=102"}, {"id": "103", "serial": "cc", "issuer": "C=US, O=Let's Encrypt, CN=R3", "issuer_name": "Let's Encrypt", "common_name": "old.example.com", "names": ["old.example.com"], "not_before": "2019-03-01T00:00:00Z", "not_after": "2019-06-01T00:00:00Z", "current": false, "wildcard": false, "url": "https://crt.sh/?id=103"}], "truncated": false, "issuers": [{"name": "Let's Encrypt", "total": 2, "current": 1, "first_issued": "2019-03-01T00:00:00Z", "last_issued": "2026-01-01T00:00:00Z"}, {"name": "DigiCert Inc", "total": 1, "current": 1, "first_issued": "2025-06-01T00:00:00Z", "last_issued": "2025-06-01T00:00:00Z"}], "names": [{"name": "example.com", "total": 2, "current": 2, "last_issued": "2026-01-01T00:00:00Z", "wildcard": false}, {"name": "www.example.com", "total": 1, "current": 1, "last_issued": "2026-01-01T00:00:00Z", "wildcard": false}, {"name": "*.example.com", "total": 1, "current": 1, "last_issued": "2025-06-01T00:00:00Z", "wildcard": true}, {"name": "old.example.com", "total": 1, "current": 0, "last_issued": "2019-03-01T00:00:00Z", "wildcard": false}], "names_truncated": false, "other_names": 0}, "error": null}}}` 200
	}
	handle /tools/domain/api/runs {
		header Content-Type application/json
		respond `{"runs": [{"id": "r2", "domain": "example.com", "domain_unicode": "example.com", "domain_a_label": "example.com", "checks": ["rdap", "tls", "headers", "ct"], "status": "complete", "created_at": "2026-01-08T00:00:00Z", "completed_at": "2026-01-08T00:00:03Z", "cost": 1, "refunded": false, "balance_after": 1}, {"id": "r1", "domain": "example.com", "domain_unicode": "example.com", "domain_a_label": "example.com", "checks": ["rdap", "tls"], "status": "complete", "created_at": "2026-01-01T00:00:00Z", "completed_at": "2026-01-01T00:00:02Z", "cost": 1, "refunded": false, "balance_after": 2}]}` 200
	}

	# wwff-pagerecon (Darkflib/wwff-pagerecon docs/contract.md), stateless: every run is the same loaded page, with a
	# few things for the page to flag (no CSP or Open Graph, an image without alt text, mixed content, an old jQuery),
	# and its screenshot is the site's own OG card, served from the image.
	@pagerecon_start {
		path /tools/page/api/runs
		method POST
	}
	handle @pagerecon_start {
		header Content-Type application/json
		respond `{"id": "p1", "url": "https://example.com/", "host": "example.com", "full_page": false, "status": "complete", "created_at": "2026-01-01T00:00:00Z", "completed_at": "2026-01-01T00:00:04Z", "cost": 1, "refunded": false, "balance_after": 2, "result": {"ok": true, "error": null, "duration_ms": 4123, "final_url": "https://example.com/", "notes": [], "document": {"status": 200, "url": "https://example.com/", "redirects": [{"url": "http://example.com/", "status": 301, "location": "https://example.com/"}], "headers": [["content-type", "text/html; charset=utf-8"], ["server", "nginx/1.18.0"], ["x-powered-by", "PHP/7.4.3"], ["set-cookie", "sid=abc; Path=/; HttpOnly"]], "remote": {"ip": "93.184.215.14", "port": 443}, "tls": {"protocol": "TLS 1.3", "issuer": "Example CA", "subject": "example.com", "valid_from": 1767225600, "valid_to": 4102444800}}, "screenshots": {"viewport": {"width": 1280, "height": 800, "bytes": 81234, "url": "/tools/page/api/runs/p1/screenshots/viewport"}, "full_page": null}, "metadata": {"title": "Example Domain", "lang": "en", "charset": "utf-8", "viewport": "width=device-width, initial-scale=1", "description": null, "canonical": null, "robots": null, "generator": "WordPress 6.4.2", "theme_color": null, "icons": [], "meta": [{"key": "name:viewport", "content": "width=device-width, initial-scale=1"}, {"key": "name:generator", "content": "WordPress 6.4.2"}], "open_graph": {}, "twitter": {}, "json_ld": []}, "structure": {"headings": [{"level": 1, "text": "Example Domain"}], "landmarks": [{"role": "main", "label": null}], "word_count": 31, "forms": 0, "iframes": [], "scripts": {"external": 2, "inline": 0, "module": 0, "async_or_defer": 1}}, "links": [{"href": "https://example.com/about", "text": "About", "rel": [], "target": null, "scheme": "https", "internal": true, "status": 404}, {"href": "https://www.iana.org/domains/example", "text": "More information", "rel": [], "target": null, "scheme": "https", "internal": false, "status": null}], "styles": {"stylesheets": [{"href": "https://example.com/site.css", "media": null, "rules": 12}], "inline_style_blocks": 1, "inline_style_attributes": 0, "fonts": [{"family": "Inter", "weight": "400", "style": "normal", "status": "loaded"}]}, "images": [{"src": "https://example.com/hero.jpg", "alt": null, "has_alt": false, "width": 600, "height": 300, "natural_width": 1200, "natural_height": 600, "loading": null, "format": "jpeg", "bytes": 182334}], "timing": {"ttfb_ms": 182, "dom_interactive_ms": 590, "dom_content_loaded_ms": 640, "load_ms": 1450, "first_contentful_paint_ms": 702, "largest_contentful_paint_ms": 1210, "cumulative_layout_shift": 0.02, "transfer_bytes": 260000, "resource_count": 5}, "requests": [{"url": "https://example.com/", "method": "GET", "type": "document", "status": 200, "mime": "text/html", "bytes": 1256, "host": "example.com", "third_party": false, "failure": null, "ms": 182}, {"url": "https://example.com/site.css", "method": "GET", "type": "stylesheet", "status": 200, "mime": "text/css", "bytes": 4100, "host": "example.com", "third_party": false, "failure": null, "ms": 40}, {"url": "https://code.jquery.com/jquery-3.4.1.min.js", "method": "GET", "type": "script", "status": 200, "mime": "application/javascript", "bytes": 88145, "host": "code.jquery.com", "third_party": true, "failure": null, "ms": 90}, {"url": "http://cdn.example.net/track.js", "method": "GET", "type": "script", "status": 200, "mime": "application/javascript", "bytes": 2100, "host": "cdn.example.net", "third_party": true, "failure": null, "ms": 60}, {"url": "https://example.com/hero.jpg", "method": "GET", "type": "image", "status": 200, "mime": "image/jpeg", "bytes": 182334, "host": "example.com", "third_party": false, "failure": null, "ms": 120}], "blocked": [{"host": "169.254.169.254", "port": 80, "ip": "169.254.169.254", "reason": "denied_address"}], "libraries": [{"name": "jQuery", "version": "3.4.1", "source": "global"}, {"name": "WordPress", "version": "6.4.2", "source": "meta"}], "csp": {"header": null, "report_only": null, "meta": [], "violations": []}, "console_errors": [], "budget": {"bytes": 280000, "bytes_limit": 26214400, "requests": 5, "requests_limit": 400, "exceeded": false}}}` 200
	}
	handle /tools/page/api/runs {
		header Content-Type application/json
		respond `{"runs": [{"id": "p1", "url": "https://example.com/", "host": "example.com", "full_page": false, "status": "complete", "created_at": "2026-01-01T00:00:00Z", "completed_at": "2026-01-01T00:00:04Z", "cost": 1, "refunded": false, "balance_after": 2}]}` 200
	}
	handle /tools/page/api/runs/p1/screenshots/viewport {
		root * /srv/www
		rewrite * /images/og-card.jpg
		file_server
	}

	handle {
		respond 404
	}
}
