# Read by Docker, and by Podman/Buildah when no .containerignore exists. One list, so the two cannot drift.

.git
.github
.claude
**/node_modules
**/.DS_Store
**/._*

# Local secrets and the snapshot fetched with them: never in a build context
.env
.env.*
.feeds

# Build outputs and test artefacts
dist
test-results
playwright-report

# Not needed to build the site
docs
tests
assets/source
